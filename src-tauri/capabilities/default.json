{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Backseat default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-resizable",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "shell:allow-open",
    "dialog:default",
    "dialog:allow-open"
  ]
}
